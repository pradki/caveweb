[Unit]
Description=caveweb - wykresy pomiarow cave (NiceGUI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sqna
WorkingDirectory=/home/sqna/cave/raspberry/caveweb
ExecStart=/home/sqna/venv/cave/bin/python3 /home/sqna/cave/raspberry/caveweb/cavewebrun.py --config /home/sqna/cave/raspberry/caveweb/caveweb.json
# Lets a non-root process bind port 443 (see README "HTTPS on port 443") without
# setcap on the shared venv's python3, which would grant it to every other script too.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# Bez tego "systemctl --user restart screen-idle.service" (po zmianie
# timeout_seconds w /settings) kończy się "$DBUS_SESSION_BUS_ADDRESS and
# $XDG_RUNTIME_DIR not defined" - ta usługa jest systemową (multi-user.target),
# nie dziedziczy więc środowiska sesji graficznej sqna, w której żyje jego
# systemd --user. Ten sam UID co w screen-idle.service.
Environment=XDG_RUNTIME_DIR=/run/user/1000
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
