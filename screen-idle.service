[Unit]
Description=Screen power management (idle blank, configurable from caveweb /settings)
After=graphical-session.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/sqna/venv/cave/bin/python3 /home/sqna/cave/raspberry/caveweb/screen_idle_runner.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
