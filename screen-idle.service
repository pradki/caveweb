[Unit]
Description=Screen power management (idle blank)
After=graphical-session.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/swayidle -w timeout 30 '/usr/bin/wlr-randr --output HDMI-A-1 --off' resume '/usr/bin/wlr-randr --output HDMI-A-1 --on; sudo -n systemctl restart wayvnc.service'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
